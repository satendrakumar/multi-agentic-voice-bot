# Copy to .env and edit. Real environment variables override these values.

# --- Prompts -------------------------------------------------------------------
# Prompt folder under prompts/ (see prompts/README.md)
SANIA_PROMPT_VERSION=v1

# --- LLM -------------------------------------------------------------------------
# Backend: openai (any OpenAI-compatible server, e.g. local vLLM) or claude (Anthropic API)
SANIA_LLM=openai
# Model for all agents (openai default: Qwen/Qwen3.5-4B, claude default: claude-opus-5-5)
SANIA_MODEL=Qwen/Qwen3.5-4B
# Optional smaller/faster model for identity, disclosure, closing and the hard-stop classifier
SANIA_FAST_MODEL=Qwen/Qwen3.5-4B

# OpenAI-compatible server (local vLLM)
SANIA_LLM_BASE_URL=http://localhost:8000/v1
# Only needed if the server requires a key (vllm serve --api-key ...)
SANIA_LLM_API_KEY=EMPTY
# Max output tokens per call; prompt + this must fit the server's max_model_len
SANIA_LLM_MAX_TOKENS=400
# Sampling (Qwen's recommended non-thinking values); presence penalty stops repeated words
SANIA_LLM_TOP_P=0.8
SANIA_LLM_PRESENCE_PENALTY=1.0
# Qwen thinking mode on vLLM: 1 = on (better answers, much slower), 0 = off. Remove for non-Qwen servers.
SANIA_LLM_THINKING=0

# Claude backend only (SANIA_LLM=claude)
# ANTHROPIC_API_KEY=

# --- Voice -------------------------------------------------------------------------
# Voice model names from sania/voice/registry.py
# STT: whisper (openai/whisper-large-v3-turbo) | indic_conformer
SANIA_STT=whisper
# TTS: kokoro (hexgrad/Kokoro-82M, lightweight) | indic_parler
SANIA_TTS=kokoro
# Noise removal before STT: rnnoise | noisereduce | none
SANIA_DENOISER=rnnoise
# Speech chunking: silero (Silero VAD) | energy
SANIA_VAD=silero
# Longest audio chunk (seconds) sent to STT
SANIA_MAX_CHUNK_S=15
# Hugging Face token for the gated AI4Bharat models (or run: hf auth login)
# HF_TOKEN=
